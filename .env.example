# Create a Gemini API key in Google AI Studio and add it here.
# Required for Q&A, quizzes, summaries, learning paths, and Gemini explanations.
GEMINI_API_KEY=

# Defaults to a current, fast Gemini model. Override if your account uses another model.
GEMINI_MODEL=gemini-2.5-flash

# Use "local" to run LaMini-Flan-T5 for concept explanations without a Gemini key.
# The first local explanation downloads the model and may take several minutes.
EDUGENIE_EXPLANATION_PROVIDER=gemini
EDUGENIE_LOCAL_MODEL=MBZUAI/LaMini-Flan-T5-783M
